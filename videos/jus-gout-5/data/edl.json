  "segments": [
    {
      "id": "S01",
      "in": 8.6,
      "out": 17.25,
      "zoom": 1.05,
      "text": "Siapa kat sini ada masalah gout, pernah tak tengah malam tiba-tiba ibu jari kaki sakit, bengkak sampai nak pijak lantai pun susah.",
      "note": "HOOK"
    },
    {
      "id": "S02",
      "in": 18.0,
      "out": 22.45,
      "zoom": 1.0,
      "text": "Gout ni berkait dengan pengumpulan kristal asid urik dalam sendi.",
      "note": ""
    },
    {
      "id": "S03",
      "in": 22.8,
      "out": 26.35,
      "zoom": 1.08,
      "text": "Bila serangan datang memang boleh mengganggu aktiviti harian kita.",
      "note": ""
    },
    {
      "id": "S04",
      "in": 26.8,
      "out": 30.85,
      "zoom": 1.0,
      "text": "Sebab tu penting untuk jaga pemakanan dan pantau paras asid urik.",
      "note": ""
    },
    {
      "id": "S05",
      "in": 35.45,
      "out": 42.75,
      "zoom": 1.08,
      "text": "Yang sedang cari minuman tambahan untuk rutin harian boleh pertimbangkan Jus Gout ni daripada Promaxx series.",
      "note": ""
    },
    {
      "id": "S06",
      "in": 43.05,
      "out": 47.65,
      "zoom": 1.0,
      "text": "Mudah nak disediakan dan boleh dijadikan sebahagian daripada rutin penjagaan diri kita.",
      "note": ""
    },
    {
      "id": "S07",
      "in": 52.1,
      "out": 55.8,
      "zoom": 1.08,
      "text": "Jangan tunggu sampai serangan gout datang berulang kali baru nak ambil berat.",
      "note": ""
    },
    {
      "id": "S08",
      "in": 56.05,
      "out": 61.8,
      "zoom": 1.0,
      "text": "Jaga makan, minum air secukupnya dan boleh ikhtiar dengan Jus Gout daripada Promaxx series ni.",
      "note": ""
    },
    {
      "id": "S09",
      "in": 62.2,
      "out": 66.5,
      "zoom": 1.08,
      "text": "Boleh klik beg kuning. Kalau harga tengah murah, boleh check out terus.",
