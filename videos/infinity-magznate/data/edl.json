  "segments": [
    {
      "id": "S01",
      "in": 4.6,
      "out": 16.55,
      "zoom": 1.0,
      "text": "Kalau korang ada dagu berlapis macam ni, atau perut buncit macam ni, korang bukan semestinya gemuk. Tapi adakah sebenarnya hormon kortisol korang yang tinggi?",
      "note": "HOOK"
    },
    {
      "id": "S02",
      "in": 17.2,
      "out": 19.75,
      "zoom": 1.1,
      "text": "Kortisol ni adalah sejenis hormon stres."
    },
    {
      "id": "S03",
      "in": 24.7,
      "out": 29.35,
      "zoom": 1.0,
      "text": "Hormon ni penting untuk badan kita supaya kita boleh buat dan siapkan kerja harian kita.",
      "note": "take 2; take 1 @20-23.5 terputus dibuang"
    },
    {
      "id": "S04",
      "in": 32.7,
      "out": 46.35,
      "zoom": 1.1,
      "text": "Tapi kalau terlalu tinggi, ia boleh menyebabkan stres yang berpanjangan, badan merasa terlalu penat, otak jadi susah nak fokus, tidur pun tak berkualiti, dan asyik rasa lapar serta teringin nak makan macam-macam."
    },
    {
      "id": "S05",
      "in": 53.85,
      "out": 63.45,
      "zoom": 1.0,
      "text": "Antara masalah yang paling ketara, susah nak tidur dan susah nak rasa tenang, sampai kadang-kadang rasa gelisah, rasa cemas, jantung berdebar-debar tanpa sebab yang jelas.",
      "note": "jeda @46.4-53.8 dibuang"
    },
    {
      "id": "S06",
      "in": 65.65,
      "out": 70.15,
      "zoom": 1.1,
      "text": "Untuk atasi masalah ni, korang kena pilih suplemen yang sesuai."
    },
    {
      "id": "S07",
      "in": 81.8,
      "out": 87.2,
      "zoom": 1.0,
      "text": "Antara suplemen yang sesuai ialah Magznate by Infinity ni, yang mengandungi magnesium.",
      "note": "take 2; 'Antaranya' dan take 1 perlahan @70.7-80.6 dibuang"
    },
    {
      "id": "S08",
      "in": 97.85,
      "out": 107.45,
      "zoom": 1.1,
      "text": "Magnesium ni boleh membantu mengurangkan hormon kortisol yang berlebihan, membantu mengawal emosi, dan juga membantu korang mendapatkan tidur yang lebih lena dan berkualiti."
    },
    {
      "id": "S09",
      "in": 153.4,
      "out": 160.3,
      "zoom": 1.0,
      "text": "Untuk korang yang ada masalah yang saya sebutkan tadi, boleh tengok dekat beg kuning. Kalau harga tengah murah, boleh check out terus!",
      "note": "CTA take 3; take 1 @114.9-135.7 (tersangkut) dan take 2 @140.8-150.4 dibuang"
    }
  ],
