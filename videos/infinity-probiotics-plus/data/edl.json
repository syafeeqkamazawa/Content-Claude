    {
      "id": "S04",
      "in": 59.45,
      "out": 65.25,
      "zoom": 1.1,
      "text": "Cara terbaik untuk ubah dari sini ke sini adalah dengan Probiotics Plus Infinity ni.",
      "note": "take 2; take 1 @43.9-48.7 terputus, take 3 @71-78.5 dibuang"
    },
    {
      "id": "S05",
      "in": 95.05,
      "out": 110.05,
      "zoom": 1.0,
      "text": "Infinity Probiotics ni mengandungi probiotik dan prebiotik sekali yang akan rawat dari dalam tau, untuk bantu sihatkan usus dan bantu flush toksin dalam badan. Ambil satu biji je setiap hari, rawat dari dalam dan korang akan tengok hasilnya di luar.",
      "note": "take 2; take 1 @78.5-85.8 terputus dibuang"
    },
    {
      "id": "S06",
      "in": 114.9,
      "out": 120.35,
      "zoom": 1.1,
      "text": "Memang mudah sebenarnya, satu botol ni boleh makan 30 hari. Halal, ada sijil KKM,",
      "note": "'dan ada... dan' @120.2-122.5 tersangkut dibuang"
