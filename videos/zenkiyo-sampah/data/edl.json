  "vo": [
    {
      "id": "V01",
      "in": 8.5,
      "out": 15.2,
      "text": "Pernah tak angkat plastik sampah, tiba-tiba koyak, habis air sampah menitik atas lantai. Memang geram weh.",
      "note": "HOOK (take 2)"
    },
    {
      "id": "V02",
      "in": 15.85,
      "out": 21.1,
      "text": "Lagi-lagi kalau sampah dapur tu banyak, plastik nipis ni kadang-kadang buat kerja kita jadi dua kali guys.",
      "note": ""
    },
    {
      "id": "V03",
      "in": 22.55,
      "out": 34.35,
      "text": "Sebab tu, saya suka sangat plastik sampah Zenkiyo ni, material HDPE, jenis extra thick dan ada pilihan bau lemon, lemongrass dan lavender.",
      "note": ""
    },
    {
      "id": "V04",
      "in": 36.2,
      "out": 42.75,
      "text": "Yang saya pakai ni size L, 50 liter, satu pack dapat 40 keping. Memang sangat praktikal untuk kegunaan harian kita.",
      "note": ""
    },
    {
      "id": "V05",
      "in": 43.3,
      "out": 48.25,
      "text": "Barang rumah macam ni memang sentiasa guna guys. Kalau tengah ada harga murah tu, terus stok siap-siap.",
      "note": "take 1"
    },
    {
      "id": "V06",
      "in": 59.6,
      "out": 61.0,
      "text": "Tekan beg kuning sekarang.",
      "note": "CTA"
    }
