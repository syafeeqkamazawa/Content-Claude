  "segments": [
    {
      "id": "S01",
      "in": 6.4,
      "out": 15.7,
      "zoom": 1.05,
      "text": "Kadang-kadang yang paling merisaukan kita sebagai ibu ayah bukan anak tak nak makan, tapi takut nutrisi yang dia perlukan untuk membesar tak cukup.",
      "note": "HOOK"
    },
    {
      "id": "S02",
      "in": 37.85,
      "out": 42.98,
      "zoom": 1.0,
      "text": "Sayur ditolak, buah pun susah nak makan, hari-hari kita cuba macam-macam.",
      "note": "take 2"
    },
    {
      "id": "S03",
      "in": 43.15,
      "out": 48.1,
      "zoom": 1.08,
      "text": "Dalam hati ni tertanya-tanya, cukup ke tak kalsium untuk tulang dan gigi dia?",
      "note": ""
    },
    {
      "id": "S04",
      "in": 48.45,
      "out": 51.05,
      "zoom": 1.0,
      "text": "Cukup ke tak nutrisi sepanjang dia membesar?",
      "note": ""
    },
    {
      "id": "S05",
      "in": 52.2,
      "out": 57.88,
      "zoom": 1.08,
      "text": "Sebab tu saya nak kongsikan dengan parent Tiny Titanz 180+ Liquid Sachet.",
      "note": ""
    },
    {
      "id": "S06",
      "in": 57.85,
      "out": 63.72,
      "zoom": 1.0,
      "text": "Ada Aquamin, sumber kalsium marine, bersama collagen HMB dan bird nest peptide.",
      "note": ""
    },
    {
      "id": "S07",
      "in": 67.35,
      "out": 74.28,
      "zoom": 1.08,
      "text": "Bentuk dia cecair, satu sachet sehari je. Terus minum tanpa perlu bancuh. Memang sangat praktikal untuk ibu ayah.",
      "note": ""
    },
    {
      "id": "S08",
      "in": 77.35,
      "out": 85.65,
      "zoom": 1.0,
      "text": "Anak-anak kita membesar sekali je, kita mungkin tak mampu buat semuanya sempurna, tapi kita boleh usaha beri yang terbaik untuk mereka.",
      "note": ""
    },
    {
      "id": "S09",
      "in": 86.15,
      "out": 90.82,
      "zoom": 1.08,
      "text": "Kalau parent berminat nak cuba produk ni, boleh tekan di beg kuning,",
      "note": "CTA"
    },
    {
      "id": "S10",
      "in": 96.25,
      "out": 99.7,
      "zoom": 1.08,
      "text": "Sementara masih ada harga promo, boleh beli sekarang.",
      "note": "CTA take 2"
    }
