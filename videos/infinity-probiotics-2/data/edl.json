  "segments": [
    {
      "id": "S01",
      "in": 2.85,
      "out": 12.3,
      "zoom": 1.05,
      "text": "Ramai orang risau pasal jantung, darah tinggi, gula, tapi ada satu bahagian badan yang kita selalu terlepas pandang, usus kita sendiri.",
      "note": "HOOK"
    },
    {
      "id": "S02",
      "in": 19.0,
      "out": 24.5,
      "zoom": 1.0,
      "text": "Pernah tak perut rasa kembung, tak selesa atau susah nak membuang.",
      "note": ""
    },
    {
      "id": "S03",
      "in": 25.05,
      "out": 30.75,
      "zoom": 1.08,
      "text": "Kadang-kadang kita anggap benda ni biasa, tapi kalau kerap sangat berlaku, jangan buat tak kisah ya.",
      "note": ""
    },
    {
      "id": "S04",
      "in": 36.0,
      "out": 41.35,
      "zoom": 1.0,
      "text": "Probiotics ni sebenarnya bakteria baik yang membantu menyokong keseimbangan bakteria dalam usus kita.",
      "note": ""
    },
    {
      "id": "S05",
      "in": 41.6,
      "out": 45.3,
      "zoom": 1.08,
      "text": "Bila kita jaga kesihatan usus, kita juga menyokong sistem penghadaman.",
      "note": ""
    },
    {
      "id": "S06",
      "in": 45.65,
      "out": 51.95,
      "zoom": 1.0,
      "text": "Infinity Probiotics Plus ni boleh jadi salah satu pilihan untuk melengkapkan rutin penjagaan kesihatan harian kita.",
      "note": ""
    },
    {
      "id": "S07",
      "in": 57.5,
      "out": 61.3,
      "zoom": 1.08,
      "text": "Kita selalu sibuk jaga macam-macam benda, sampai terlupa nak jaga badan sendiri.",
      "note": ""
    },
    {
      "id": "S08",
      "in": 61.6,
      "out": 64.8,
      "zoom": 1.0,
      "text": "Jangan tunggu sampai rasa tak selesa, baru nak ambil berat tau.",
      "note": ""
    },
    {
      "id": "S09",
      "in": 64.95,
      "out": 71.95,
      "zoom": 1.08,
      "text": "Nak cuba Infinity Probiotics Plus ni, tekan beg kuning sekarang. Harga kalau tengah promo tu, beli terus.",
      "note": "CTA"
    }
  ],
