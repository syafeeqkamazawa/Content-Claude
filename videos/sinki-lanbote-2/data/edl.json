    {
      "id": "V06",
      "in": 28.1,
      "out": 32.4,
      "text": "Yang bestnya bila dah penuh, angkat, buang. Kemudian pasang dia yang baru.",
      "note": ""
    },
    {
      "id": "V07",
      "in": 32.75,
      "out": 35.45,
      "text": "Tak payah nak kutip sisa makanan satu-satu dengan tangan guys.",
      "note": ""
    },
    {
      "id": "V08",
      "in": 35.6,
      "out": 37.7,
      "text": "Mudah, cepat dan lebih bersih.",
