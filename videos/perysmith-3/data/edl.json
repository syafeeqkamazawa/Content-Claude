  "vo": [
    {
      "id": "V01",
      "in": 1.95,
      "out": 9.25,
      "text": "Alamak, air coklat tumpah atas karpet, guys. Kalau dibiarkan memang risau kesan kotoran ni susah nak hilang.",
      "note": "HOOK"
    },
    {
      "id": "V02",
      "in": 10.0,
      "out": 17.35,
      "text": "Haa, nasib baik ada PerySmith M2 Lite II Spot Cleaner ni. Sembur air, kemudian sedut kotoran menggunakan mesin ni.",
      "note": ""
    },
    {
      "id": "V03",
      "in": 17.7,
      "out": 20.95,
      "text": "Tengok sendiri macam mana kesan air coklat tadi dibersihkan.",
      "note": ""
    },
    {
      "id": "V04",
      "in": 21.65,
      "out": 29.9,
      "text": "Dan yang paling puas hati, tengok air dalam tangki ni. Keruh betul. Tak sangka sebanyak ni kotoran yang berjaya disedut.",
      "note": ""
    },
    {
      "id": "V05",
      "in": 30.8,
      "out": 34.95,
      "text": "Karpet, sofa, tempat duduk kereta pun boleh, guna pada fabrik yang sesuai.",
      "note": ""
    },
    {
      "id": "V06",
      "in": 34.97,
      "out": 37.75,
      "text": "Nak kerja mencuci lebih mudah, tekan beg kuning sekarang.",
      "note": ""
    },
    {
      "id": "V07",
      "in": 42.2,
      "out": 45.4,
      "text": "Kalau harga tengah murah tu, grab terus.",
      "note": "CTA"
    }
  ],
