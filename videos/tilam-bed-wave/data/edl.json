  "vo": [
    {
      "id": "V01",
      "in": 1.82,
      "out": 8.62,
      "text": "Eh korang tengok ni, tak sangka tilam setebal 10 inci ni boleh sampai rumah dalam keadaan bergulung macam ni.",
      "note": "hook; klik @1.1 dibuang"
    },
    {
      "id": "V02",
      "in": 9.45,
      "out": 12.38,
      "text": "Ini tilam Bed Wave daripada Steady Line Bedding tau."
    },
    {
      "id": "V03",
      "in": 12.5,
      "out": 18.25,
      "text": "Bila buka je plastik dia, tilam ni mula mengembang. Memang menarik tengok proses dia weh."
    },
    {
      "id": "V04",
      "in": 19.25,
      "out": 23.8,
      "text": "Yang menariknya, harga untuk saiz queen boleh jadi serendah RM300 je masa promo."
    },
    {
      "id": "V05",
      "in": 23.95,
      "out": 26.4,
      "text": "Cuba tengok ketebalan dia, 10 inci tau."
    },
    {
      "id": "V06",
      "in": 26.55,
      "out": 34.15,
      "text": "Bila baring dia, baru boleh rasa sendiri tahap keselesaan dia, memang sangat empuk dan feel premium je."
    },
    {
      "id": "V07",
      "in": 34.95,
      "out": 39.34,
      "text": "Tilam ni menggunakan pocketed spring system untuk sokongan yang lebih stabil."
    },
    {
      "id": "V08",
      "in": 42.24,
      "out": 48.7,
      "text": "Dia juga ada 3D mesh fabric layer dan material breathable untuk membantu pengudaraan supaya lebih selesa waktu tidur.",
      "note": "take 1 'dia juga ada 3D' @39.73-41.93 dibuang"
    },
    {
      "id": "V09",
      "in": 49.15,
      "out": 53.8,
      "text": "Kalau tidur berdua, pergerakan pasangan pun boleh jadi kurang terasa sebab sistem spring dia,"
    },
    {
      "id": "V10",
      "in": 56.26,
      "out": 59.4,
      "text": "tapi mestilah bergantung pada cara kita bergerak juga.",
      "note": "take 1 'tapi mestilah bergantung pada ciri kita' @53.76-56.24 dibuang"
    },
    {
      "id": "V11",
      "in": 60.0,
      "out": 63.25,
      "text": "Tilam ni ada pilihan single, super single, queen dan king."
    },
    {
      "id": "V12",
      "in": 63.3,
      "out": 68.18,
      "text": "Kalau korang tengah cari tilam baru untuk bilik sendiri atau keluarga, boleh tengok Bed Wave ni."
    },
    {
      "id": "V13",
      "in": 69.74,
      "out": 74.92,
      "text": "Tekan beg kuning, sementara harga promo, kalau tengah murah tu, terus check out guys!",
